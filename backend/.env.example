# ==========================================
# CẤU HÌNH DATABASE (Supabase / Local)
# ==========================================
DATABASE_URL=jdbc:postgresql://<your_supabase_url>/postgres?prepareThreshold=0
DATABASE_USERNAME=postgres.YOUR_USERNAME
DATABASE_PASSWORD=YOUR_PASSWORD

# ==========================================
# CẤU HÌNH BẢO MẬT (JWT)
# ==========================================
JWT_SECRET=your_base64_encoded_jwt_secret_here_replace_with_a_long_random_string

# ==========================================
# CẤU HÌNH EMAIL (Gửi thông báo)
# ==========================================
# Use Google App Password, not your real Gmail password
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ==========================================
# CẤU HÌNH CLOUDINARY (Upload Hình Ảnh)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# CẤU HÌNH SEPAY (Thanh toán chuyển khoản)
# ==========================================
SEPAY_API_KEY=your_sepay_api_key
SEPAY_WEBHOOK_SECRET=your_webhook_secret
SEPAY_VA_ACCOUNT=your_va_account
SEPAY_VIETQR_BASE_URL=https://qr.sepay.vn/img

# ==========================================
# CẤU HÌNH FOLDER UPLOAD (Tùy chọn)
# ==========================================
UPLOAD_IMAGE_FOLDER=aurafit
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880

# ==========================================
# CẤU HÌNH OPENAI VIRTUAL TRY-ON (gpt-image-1)
# ==========================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_CONNECT_TIMEOUT_MS=10000
OPENAI_READ_TIMEOUT_MS=120000

# ==========================================
# CẤU HÌNH REPLICATE (Virtual Try-On IDM-VTON)
# ==========================================
REPLICATE_API_TOKEN=your_replicate_api_token

# ==========================================
# CẤU HÌNH GIAO HÀNG NHANH (GHN)
# ==========================================
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_API_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_shop_id

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
AI_ENABLED=true
AI_EMBEDDING_MODEL=text-embedding-004
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=15000
GEMINI_THINKING_BUDGET=0
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
