# ==========================================
# CẤU HÌNH DATABASE (Supabase / Local)
# ==========================================
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<password>

# ==========================================
# CẤU HÌNH BẢO MẬT (JWT)
# ==========================================
JWT_SECRET=<your_256_bit_secret_key>

# ==========================================
# CẤU HÌNH EMAIL (Gửi thông báo)
# ==========================================
MAIL_USERNAME=<your_email@gmail.com>
MAIL_PASSWORD=<your_app_password>

# ==========================================
# CẤU HÌNH CLOUDINARY (Upload Hình Ảnh)
# ==========================================
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ==========================================
# CẤU HÌNH SEPAY (Thanh toán chuyển khoản)
# ==========================================
SEPAY_API_KEY=<your_sepay_api_key>
SEPAY_WEBHOOK_SECRET=<your_sepay_webhook_secret>
SEPAY_VA_ACCOUNT=<your_sepay_virtual_account>
SEPAY_VIETQR_BASE_URL=https://api.se-pay.com/v1/vietqr/image

# ==========================================
# CẤU HÌNH FOLDER UPLOAD (Tùy chọn)
# ==========================================
UPLOAD_IMAGE_FOLDER=aurafit
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880

# ==========================================
# CẤU HÌNH AI RECOMMENDATION (Gemini OpenAI compatibility)
# ==========================================
AI_ENABLED=false
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER_API_KEY=<your_provider_api_key>
AI_EMBEDDING_MODEL=gemini-embedding-2-preview
AI_CHAT_MODEL=gemini-3.5-flash
AI_FALLBACK_EMBEDDING_DIMENSION=64
AI_DEFAULT_RECOMMENDATION_LIMIT=6
AI_CANDIDATE_POOL_SIZE=24
AI_PROFILE_TOP_TAG_LIMIT=5
AI_PROFILE_STALE_MINUTES=60
AI_REASONING_RANKING_ENABLED=false
AI_SIMILAR_PRODUCTS_REASONING_ENABLED=false
AI_HOMEPAGE_REASONING_ENABLED=false
AI_LLM_EXPLANATION_ENABLED=false
AI_PROVIDER_CONNECT_TIMEOUT_MS=2000
AI_PROVIDER_READ_TIMEOUT_MS=6000
AI_PROVIDER_MAX_RETRIES=1
AI_REASONING_CONNECT_TIMEOUT_MS=2000
AI_REASONING_READ_TIMEOUT_MS=9000
AI_REASONING_RATE_LIMIT_PER_MINUTE=12
AI_REASONING_CIRCUIT_FAILURE_THRESHOLD_PERCENT=30
AI_REASONING_CIRCUIT_WINDOW_MINUTES=5
AI_REASONING_CIRCUIT_COOLDOWN_MINUTES=10
AI_REASONING_CIRCUIT_MINIMUM_CALLS=10

# ==========================================
# CẤU HÌNH OPENAI VIRTUAL TRY-ON (gpt-image-1)
# ==========================================
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_CONNECT_TIMEOUT_MS=10000
OPENAI_READ_TIMEOUT_MS=120000
