# ==========================================
# CẤU HÌNH DATABASE (Supabase / Local)
# ==========================================
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<password>

# ==========================================
# CẤU HÌNH BẢO MẬT (JWT)
# ==========================================
JWT_SECRET=<your_256_bit_secret_key>

# ==========================================
# CẤU HÌNH EMAIL (Gửi thông báo)
# ==========================================
MAIL_USERNAME=<your_email@gmail.com>
MAIL_PASSWORD=<your_app_password>

# ==========================================
# CẤU HÌNH CLOUDINARY (Upload Hình Ảnh)
# ==========================================
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ==========================================
# CẤU HÌNH SEPAY (Thanh toán chuyển khoản)
# ==========================================
SEPAY_WEBHOOK_TOKEN=CHANGE_ME_IN_PRODUCTION

# ==========================================
# CẤU HÌNH FOLDER UPLOAD (Tùy chọn)
# ==========================================
UPLOAD_IMAGE_FOLDER=aurafit
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880

# ==========================================
# CAU HINH AI RECOMMENDATION (MVP)
# ==========================================
AI_ENABLED=true
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4.1-mini
AI_FALLBACK_EMBEDDING_DIMENSION=64
AI_DEFAULT_RECOMMENDATION_LIMIT=6
AI_CANDIDATE_POOL_SIZE=24
AI_PROFILE_TOP_TAG_LIMIT=5
AI_PROFILE_STALE_MINUTES=60
AI_LLM_EXPLANATION_ENABLED=true
