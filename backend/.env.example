# ==========================================
# CẤU HÌNH DATABASE (Supabase / Local)
# ==========================================
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<password>

# ==========================================
# CẤU HÌNH BẢO MẬT (JWT)
# ==========================================
JWT_SECRET=<your_256_bit_secret_key>

# ==========================================
# CẤU HÌNH EMAIL (Gửi thông báo)
# ==========================================
MAIL_USERNAME=<your_email@gmail.com>
MAIL_PASSWORD=<your_app_password>

# ==========================================
# CẤU HÌNH CLOUDINARY (Upload Hình Ảnh)
# ==========================================
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ==========================================
# CẤU HÌNH SEPAY (Thanh toán chuyển khoản)
# ==========================================
SEPAY_API_KEY=<your_sepay_api_key>
SEPAY_WEBHOOK_SECRET=<your_sepay_webhook_secret>
SEPAY_VA_ACCOUNT=<your_sepay_virtual_account>
SEPAY_VIETQR_BASE_URL=https://api.se-pay.com/v1/vietqr/image

# ==========================================
# CẤU HÌNH FOLDER UPLOAD (Tùy chọn)
# ==========================================
UPLOAD_IMAGE_FOLDER=aurafit
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880



# ==========================================
# CẤU HÌNH OPENAI VIRTUAL TRY-ON (gpt-image-1)
# ==========================================
OPENAI_API_KEY=<your_openai_api_key>
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_CONNECT_TIMEOUT_MS=10000
OPENAI_READ_TIMEOUT_MS=120000


GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-3.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=15000
GEMINI_THINKING_BUDGET=0
